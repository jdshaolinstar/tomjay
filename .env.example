# Copy to .env and fill in. The server re-reads .env on every request, so no restart is needed.
# Never commit .env. Everything below is optional: without keys the app runs in sample mode.

# Writes the three takes. https://platform.claude.com
ANTHROPIC_API_KEY=

# Checks that answers are in people's own words. http://pangram.com/apikey
PANGRAM_API_KEY=

# Optional: makes video clips inside the app. You can also make clips in Kino and upload them. https://fal.ai/dashboard/keys
FAL_KEY=

# Spending guard. Clips are only generated when VIDEO_LIVE=1.
VIDEO_LIVE=0
VIDEO_MAX_CLIPS=6
VIDEO_SECONDS=5
VIDEO_RESOLUTION=480p
FAL_VIDEO_MODEL=bytedance/seedance-2.0/fast/text-to-video
